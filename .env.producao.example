# Copie para .env.producao e ajuste. Não versionar o .env.producao.
POSTGRES_SENHA=troque-esta-senha-do-banco
SEED_EMPRESA=Minha Marcenaria
SEED_ADMIN_EMAIL=admin@minhamarcenaria.com.br
# Senha inicial do administrador (o app pede para trocar no primeiro acesso)
SEED_ADMIN_SENHA=troque-no-primeiro-acesso
# Porta no servidor (acesse http://ip-do-servidor:PORTA)
PORTA=3000
# Deixe vazio: o cookie fica "secure" automaticamente quando o acesso é por HTTPS
COOKIE_SEGURO=
